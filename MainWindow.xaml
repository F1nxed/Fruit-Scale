<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fruit_Scale.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fruit_Scale"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fruit-Scale">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Padding="20"
        RowSpacing="20"
        ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <!--Item Buttons-->
        <Button
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Bananas"
            Click="Button_Click"/>

        <Button
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Apples"
            Click="Button_Click"/>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Oranges"
            Click="Button_Click"/>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Grapes"
            Click="Button_Click"/>

        <Button
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Cucumber"
            Click="Button_Click"/>

        <Button
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Content="Tomatoes"
            Click="Button_Click"/>
        <!--Information box-->
        <StackPanel
            Grid.Column="2"
            Grid.Row="0"
            Grid.RowSpan="4"
            Padding="20"
            Spacing="20">

            <TextBox 
                Header="Weight"
                x:Name="weightBox"
                Text="0.00 kg"/>

            <TextBox 
                Header="Price €/kg"
                x:Name="priceBox"
                Text="0.00 €"/>

            <TextBox
                Header="Total price"
                x:Name="totalBox"
                Text="0.00 €"/>
        </StackPanel>
        <!--Admin Panel-->

        <StackPanel
            x:Name="adminPanel"
            Grid.Column="3"
            Grid.Row="0"
            Grid.RowSpan="4"
            Padding="20"
            Spacing="20">

            <TextBox
                Header="Item Name"
                x:Name="itemNameBox"/>

            <NumberBox
                Header="€/Kg"
                x:Name="newPriceBox"
                Value="0"/>

            <Button
                Content="Add"
                HorizontalAlignment="Stretch"
                x:Name="AddButton"
                Click="AddButton_Click"/>

            <ListView 
                x:Name="productListView" 
                Height="500">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Name}" Width="100"/>
                            <TextBlock Text="{Binding Price}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Content="Remove"
                x:Name="RemoveButton"
                HorizontalAlignment="Stretch"
                Click="RemoveButton_Click"/>


        </StackPanel>

    </Grid>
</Window>